{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["davide"],
  "extends": ["config:best-practices", ":semanticCommits"],
  "packageRules": [
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchFileNames": [".devcontainer/**", ".forgejo/**"],
      "matchUpdateTypes": ["!major"]
    }
  ],
  // Raise limit or there are situations where we can't keep up with the number
  // of deps to update.
  "prHourlyLimit": 4
}
